# ─── Anthropic (Claude AI) ───────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Gmail ────────────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# File type: "Desktop app" OAuth 2.0 Client ID  →  download as JSON
GMAIL_CREDENTIALS_FILE=credentials_gmail.json

# ─── Microsoft / Office 365 ───────────────────────────────────────────────────
# Register an app at: https://portal.azure.com → Azure Active Directory → App Registrations
# Set redirect URI to: http://localhost:5000/auth/outlook/callback
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=common

# ─── Optional Settings ────────────────────────────────────────────────────────
# Hours to look back (default: 24)
LOOKBACK_HOURS=24
# Set to true to do a dry run (no emails actually moved/labeled)
DRY_RUN=false
